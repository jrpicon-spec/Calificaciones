@page "/"
@using Calificaciones.Services
@inject DemoAuthenticationService AuthenticationService
@inject NavigationManager Navigation

<main class="login-page">
    <div class="login-backdrop login-backdrop--one" aria-hidden="true"></div>
    <div class="login-backdrop login-backdrop--two" aria-hidden="true"></div>

    <section class="login-layout" aria-labelledby="login-title">
        <header class="login-brand">
            <div class="login-brand__mark" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>
            <div class="login-brand__copy">
                <p>INSTITUTO <strong>SUDAMERICANO</strong></p>
                <span>SUDAMERICANO GRADE</span>
            </div>
        </header>

        <section class="login-card @(hasError ? "login-card--error" : string.Empty)">
            <div class="login-card__eyebrow"><span></span> PORTAL ACADÉMICO</div>
            <h1 id="login-title">¡Bienvenido de nuevo!</h1>
            <p class="login-card__subtitle">Accede a tu espacio académico</p>

            <form class="login-form" autocomplete="off" novalidate @onsubmit="SignIn" @onsubmit:preventDefault="true">
                <div class="login-field">
                    <label for="login-username">Usuario</label>
                    <span class="login-input-wrap">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.25"/><path d="M5.5 20c.3-3.35 2.8-5.5 6.5-5.5s6.2 2.15 6.5 5.5"/></svg>
                        <input id="login-username" type="text" name="username" autocomplete="username" placeholder="Ingresa tu usuario" aria-invalid="@(usernameInvalid ? "true" : "false")" aria-describedby="@(usernameInvalid ? "username-error" : null)" value="@username" @oninput="OnUsernameInput" />
                    </span>
                    @if (usernameInvalid)
                    {
                        <span class="login-field-error" id="username-error">@(string.IsNullOrWhiteSpace(username) ? "Ingresa tu usuario para continuar." : "Revisa el usuario ingresado.")</span>
                    }
                </div>

                <div class="login-field">
                    <label for="login-password">Contraseña</label>
                    <span class="login-input-wrap @(passwordInvalid ? "login-input-wrap--invalid" : string.Empty)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v2"/></svg>
                        <input id="login-password" type="@PasswordInputType" name="password" autocomplete="current-password" placeholder="Ingresa tu contraseña" aria-invalid="@(passwordInvalid ? "true" : "false")" aria-describedby="@(passwordInvalid ? "password-error" : null)" value="@password" @oninput="OnPasswordInput" />
                        <button class="login-input-affordance" type="button" aria-label="@(isPasswordVisible ? "Ocultar contraseña" : "Mostrar contraseña")" aria-pressed="@isPasswordVisible" @onclick="TogglePasswordVisibility">
                            @if (isPasswordVisible)
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.2A10.7 10.7 0 0 1 12 5c6.1 0 9.5 7 9.5 7a15.5 15.5 0 0 1-3 3.7M6.2 6.2C3.8 7.8 2.5 12 2.5 12s3.4 7 9.5 7c1 0 1.9-.2 2.7-.5"/></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                            }
                        </button>
                    </span>
                    @if (passwordInvalid)
                    {
                        <span class="login-field-error" id="password-error">@(string.IsNullOrWhiteSpace(password) ? "Ingresa tu contraseña para continuar." : "El usuario o la contraseña no son correctos.")</span>
                    }
                </div>

                @if (hasError)
                {
                    <p class="login-error" role="alert" aria-live="polite">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5m0 3h.01"/></svg>
                        @errorMessage
                    </p>
                }

                <button class="login-submit" type="submit" disabled="@isSubmitting">
                    <span>Iniciar sesión</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                </button>
            </form>

            <div class="login-card__note login-card__note--demo">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5m0-8h.01"/></svg>
                <span><strong>Demostración local</strong><code>Usuario: demo · Contraseña: Sudamericano123</code><small>No es un sistema de seguridad de producción.</small></span>
            </div>
        </section>

        <footer class="login-footer">
            <span>INSTITUTO SUDAMERICANO</span>
            <i aria-hidden="true"></i>
            <span>Tu esfuerzo, tus resultados</span>
        </footer>
    </section>
</main>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string? errorMessage;
    private bool isPasswordVisible;
    private bool isSubmitting;
    private bool usernameInvalid;
    private bool passwordInvalid;
    private bool hasError;

    private string PasswordInputType => isPasswordVisible ? "text" : "password";

    private void SignIn()
    {
        if (isSubmitting)
        {
            return;
        }

        hasError = false;
        usernameInvalid = string.IsNullOrWhiteSpace(username);
        passwordInvalid = string.IsNullOrEmpty(password);

        if (usernameInvalid || passwordInvalid)
        {
            errorMessage = "Completa los campos indicados para continuar.";
            hasError = true;
            return;
        }

        isSubmitting = true;
        try
        {
            if (AuthenticationService.TrySignIn(username.Trim(), password))
            {
                Navigation.NavigateTo("/grades", replace: true);
                return;
            }

            usernameInvalid = true;
            passwordInvalid = true;
            errorMessage = "El usuario o la contraseña no son correctos.";
            hasError = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OnUsernameInput(ChangeEventArgs args)
    {
        username = Convert.ToString(args.Value) ?? string.Empty;
        ClearError();
    }

    private void OnPasswordInput(ChangeEventArgs args)
    {
        password = Convert.ToString(args.Value) ?? string.Empty;
        ClearError();
    }

    private void TogglePasswordVisibility() => isPasswordVisible = !isPasswordVisible;

    private void ClearError()
    {
        hasError = false;
        usernameInvalid = false;
        passwordInvalid = false;
        errorMessage = null;
    }
}
