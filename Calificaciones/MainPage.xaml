<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Calificaciones.Components"
             x:Class="Calificaciones.MainPage"
             BackgroundColor="#102344">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="WelcomeGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#102344" Offset="0.0" />
            <GradientStop Color="#173763" Offset="0.58" />
            <GradientStop Color="#234F91" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid>
        <BlazorWebView x:Name="MainContent" HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <Grid x:Name="WelcomeOverlay"
              Background="{StaticResource WelcomeGradient}"
              ZIndex="10">
            <Ellipse WidthRequest="270"
                     HeightRequest="110"
                     Stroke="#30C1D8D7"
                     StrokeThickness="1"
                     Rotation="-24"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                     Margin="0,0,0,240"
                     InputTransparent="True" />
            <Ellipse WidthRequest="220"
                     HeightRequest="86"
                     Stroke="#3095BDAE"
                     StrokeThickness="1"
                     Rotation="32"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                     Margin="0,0,0,240"
                     InputTransparent="True" />

            <VerticalStackLayout Spacing="0"
                                 Padding="28"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Grid x:Name="BrandMark"
                      WidthRequest="94"
                      HeightRequest="94"
                      Opacity="0"
                      Scale="0.82"
                      TranslationY="10"
                      HorizontalOptions="Center"
                      SemanticProperties.Description="Símbolo geométrico académico">
                    <Border BackgroundColor="#18FFFFFF"
                            Stroke="#55FFFFFF"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 25"
                            Padding="22">
                        <Grid ColumnDefinitions="7,7,7"
                              ColumnSpacing="5"
                              HorizontalOptions="Center"
                              VerticalOptions="Center">
                            <Border Grid.Column="0" WidthRequest="7" HeightRequest="25" VerticalOptions="End"
                                    BackgroundColor="#A4D8CB" StrokeThickness="0" StrokeShape="RoundRectangle 3" />
                            <Border Grid.Column="1" WidthRequest="7" HeightRequest="40" VerticalOptions="End"
                                    BackgroundColor="#D4EEE7" StrokeThickness="0" StrokeShape="RoundRectangle 3" />
                            <Border Grid.Column="2" WidthRequest="7" HeightRequest="31" VerticalOptions="End"
                                    BackgroundColor="#79BFAE" StrokeThickness="0" StrokeShape="RoundRectangle 3" />
                        </Grid>
                    </Border>
                </Grid>

                <Label x:Name="InstituteName"
                       Text="INSTITUTO SUDAMERICANO"
                       FontSize="12"
                       FontAttributes="Bold"
                       CharacterSpacing="2.4"
                       TextColor="#DCE7F3"
                       Opacity="0"
                       TranslationY="8"
                       HorizontalTextAlignment="Center"
                       Margin="0,31,0,0" />

                <BoxView WidthRequest="38"
                         HeightRequest="1"
                         Color="#68B6A4"
                         HorizontalOptions="Center"
                         Margin="0,19,0,19" />

                <Label x:Name="ProductTitle"
                       Text="SUDAMERICANO GRADE"
                       FontSize="25"
                       FontAttributes="Bold"
                       CharacterSpacing="1.3"
                       TextColor="White"
                       Opacity="0"
                       TranslationY="8"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="Tagline"
                       Text="Tu esfuerzo, tus resultados"
                       FontSize="14"
                       CharacterSpacing="0.3"
                       TextColor="#C1D0E1"
                       Opacity="0"
                       TranslationY="8"
                       HorizontalTextAlignment="Center"
                       Margin="0,11,0,0" />

                <Label x:Name="FarewellTitle"
                       Text="¡Hasta pronto!"
                       FontSize="25"
                       FontAttributes="Bold"
                       CharacterSpacing="0.3"
                       TextColor="White"
                       Opacity="0"
                       TranslationY="8"
                       IsVisible="False"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="FarewellMessage"
                       Text="Gracias por utilizar Sudamericano Grade"
                       FontSize="14"
                       CharacterSpacing="0.1"
                       TextColor="#C1D0E1"
                       Opacity="0"
                       TranslationY="8"
                       IsVisible="False"
                       HorizontalTextAlignment="Center"
                       Margin="0,11,0,0" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
